{
  "type": "object",
  "required": ["id", "name_ar", "name_en", "version", "kind", "inputs", "outputs", "label", "source", "max_age_hours", "schedule", "run"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name_ar": {"type": "string", "pattern": "."},
    "name_en": {"type": "string", "pattern": "."},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "kind": {"type": "string", "enum": ["source", "compute", "strategy", "agent", "view"]},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "schema"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9_-]+$"}, "schema": {"type": "string"}}}},
    "label": {"type": "string", "enum": ["measured", "simulated", "live", "hypothesis", "ai"]},
    "source": {"type": "object", "required": ["name", "url"],
      "properties": {"name": {"type": "string"}, "url": {"type": "string", "pattern": "^https?://"}}},
    "max_age_hours": {"type": "number", "minimum": 0},
    "schedule": {"type": "string", "enum": ["daily", "on-change", "manual"]},
    "run": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "history": {"type": "array", "items": {"type": "string"}},
    "timeout_s": {"type": "number", "minimum": 1},
    "view": {"type": "object", "required": ["tab", "title", "type"],
      "properties": {"tab": {"type": "string"}, "title": {"type": "string"},
        "type": {"type": "string", "enum": ["number", "table", "text", "chart", "progress"]}}}
  }
}
