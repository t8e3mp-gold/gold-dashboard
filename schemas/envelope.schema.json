{
  "type": "object",
  "required": ["id", "value", "unit", "source", "fetched_at", "label", "max_age_hours", "checked_against"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_.:-]+$"},
    "value": {"type": ["number", "string", "boolean", "object", "array"]},
    "unit": {"type": "string"},
    "source": {"type": "object", "required": ["name", "url"],
      "properties": {"name": {"type": "string", "pattern": "."}, "url": {"type": "string", "pattern": "^https?://"}}},
    "fetched_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+(Z|[+-][0-9:]+)$"},
    "label": {"type": "string", "enum": ["measured", "simulated", "live", "hypothesis", "ai"]},
    "max_age_hours": {"type": "number", "minimum": 0},
    "checked_against": {"type": ["object", "null"]}
  }
}
