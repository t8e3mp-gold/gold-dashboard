{
  "id": "volume-profile",
  "name_ar": "بروفايل الحجم (POC ومنطقة القيمة) لـ XAUT وBNB وETH وSOL",
  "name_en": "Volume profile",
  "version": "1.0.0",
  "kind": "compute",
  "inputs": ["klines"],
  "outputs": [{"id": "volume-profile", "schema": "schema/volume-profile.schema.json"}],
  "label": "measured",
  "source": {"name": "Binance public data mirror, 1-minute candles (volume spread across each candle's range)", "url": "https://data-api.binance.vision/api/v3/klines"},
  "max_age_hours": 8,
  "schedule": "daily",
  "run": ["python", "run.py"],
  "permissions": {"network": true},
  "timeout_s": 200,
  "view": {"tab": "modules", "title": "بروفايل الحجم", "type": "chart"}
}
